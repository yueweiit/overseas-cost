{
  "doctype": "DocType",
  "name": "Overseas Cost Audit Log",
  "module": "Overseas Costing",
  "autoname": "hash",
  "title_field": "action_type",
  "track_changes": 1,
  "sort_field": "creation",
  "sort_order": "DESC",
  "field_order": [
    "batch",
    "version",
    "action_type",
    "field_name",
    "row_no",
    "old_value",
    "new_value",
    "operator_name",
    "action_remark"
  ],
  "fields": [
    {
      "fieldname": "batch",
      "fieldtype": "Link",
      "label": "所属批次",
      "options": "Overseas Cost Batch",
      "reqd": 1
    },
    {
      "fieldname": "version",
      "fieldtype": "Link",
      "label": "所属版本",
      "options": "Overseas Cost Version"
    },
    {
      "fieldname": "action_type",
      "fieldtype": "Select",
      "label": "动作类型",
      "options": "IMPORT\nEDIT\nBATCH_EDIT\nRECALCULATE\nCREATE_VERSION\nSWITCH_VERSION\nUPLOAD_ATTACHMENT\nWRITEBACK",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "field_name",
      "fieldtype": "Data",
      "label": "字段名"
    },
    {
      "fieldname": "row_no",
      "fieldtype": "Int",
      "label": "行号"
    },
    {
      "fieldname": "old_value",
      "fieldtype": "Small Text",
      "label": "旧值"
    },
    {
      "fieldname": "new_value",
      "fieldtype": "Small Text",
      "label": "新值"
    },
    {
      "fieldname": "operator_name",
      "fieldtype": "Data",
      "label": "操作人"
    },
    {
      "fieldname": "action_remark",
      "fieldtype": "Small Text",
      "label": "动作备注"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "share": 1,
      "print": 1,
      "email": 1,
      "export": 1
    }
  ]
}
